<?xml version="1.0" encoding="utf-8"?>
<!--
  L9c: Android 12+ (API 31+) backup/transfer rules. Backups are already
  disabled via android:allowBackup="false"; these rules additionally exclude
  all app data from cloud backup AND device-to-device transfer as
  defence-in-depth, so tokens and the biometric enrollment marker never leave
  the device. The master key lives in the secure enclave and is never eligible
  for backup regardless.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
