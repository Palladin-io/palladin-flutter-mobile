<?xml version="1.0" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <uses-permission android:name="android.permission.REORDER_TASKS"/>
    <application android:label="Palladin synthetic provider" android:allowBackup="false" android:theme="@style/AutofillAuthenticationTheme">
        <activity android:name="io.palladin.mobile.PresentationPreviewActivity" android:exported="true" android:theme="@android:style/Theme.Material.Light.NoActionBar"/>
        <activity android:name="io.palladin.mobile.ReturnSourceProbe" android:exported="true"/>
        <activity android:name="io.palladin.mobile.ReturnPickerProbe" android:exported="true" android:taskAffinity="" android:launchMode="singleTop"/>
        <activity android:name="io.palladin.mobile.VirtualSessionProbeAuth" android:exported="false"/>
        <activity android:name="io.palladin.mobile.VirtualSessionProbePicker" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:taskAffinity="io.palladin.synthetic.picker"/>
        <service android:name="io.palladin.mobile.VirtualSessionProbeService" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService"/></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/session_probe_service"/>
        </service>
        <activity android:name="io.palladin.mobile.MainActivity" android:exported="true"/>
        <activity android:name="io.palladin.mobile.autofill.AutofillAuthenticationActivity" android:exported="false" android:noHistory="true"/>
        <receiver android:name="io.palladin.mobile.RevokeSyntheticCacheReceiver" android:exported="true"/>
        <service android:name="io.palladin.mobile.autofill.PalladinAutofillService" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService"/>
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service"/>
        </service>
    </application>
</manifest>
